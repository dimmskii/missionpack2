//	top bar	//
  itemDef {
      	name topbar
      	style 2
      	rect 0 5 640 40 
      	style 2
      	border 4
      	bordercolor 0.5 0.5 0.5 0.75
      	bordersize 2
	backcolor 0 0 0 .75
      	visible 1 
      	decoration 
	mouseEnter { setcolor backcolor .25 .25 .25 .75 }
      	mouseExit { setcolor backcolor 0 0 0 .75 }
    }


// GLOBAL SETTINGS



itemDef {
      	name gametypefield
      	style 0	
	ownerdraw UI_HOSTGAMEFACTORY
	text "Rules:"
	textstyle 6
      	rect 0 10 320 31 
      	textalign ITEM_ALIGN_LEFT		
      	textalignx 20     
      	textaligny 26    
	textscale .416     
      	forecolor 1 1 1 1
      	visible 1
	action { play "sound/misc/menu1.wav" }
	mouseEnter { fadein message_rules } 
	mouseExit { fadeout message_rules } 
    }

itemDef {
      	name gametypefield
      	style 0	
	ownerdraw UI_SKILL
	textstyle 6
	text "Skill:"
      	rect 320 10 320 31 
      	textalign ITEM_ALIGN_LEFT		
      	textalignx 90     
      	textaligny 26    
	textscale .416    
      	forecolor 1 1 1 1
      	visible 1
	action { play "sound/misc/menu1.wav" }
	mouseEnter { fadein message_skill } 
	mouseExit { fadeout message_skill }  
    }


// map selection

itemDef {
      	name mappreview
      	style 0	
 	ownerdraw UI_STARTMAPCINEMATIC
      	rect 7 55 190 141
      	border 4
      	bordercolor 0 0 0 .75
      	visible 1 
		action { play "sound/misc/menu1.wav" ; close createserver ; open maps }
		mouseEnter { setcolor bordercolor .25 .25 .25 .75 ; play "sound/misc/menu2.wav"; fadein message_arena }
      	mouseExit { setcolor bordercolor 0 0 0 .75 ; fadeout message_arena }
    	}

itemDef {
      	name mappreview
     	style WINDOW_STYLE_FILLED
      	rect 6 54 192 143
      	border 4
      	bordercolor 0 0 0 .75
      	visible 1
		mouseEnter { setcolor bordercolor .25 .25 .25 .75 }
      	mouseExit { setcolor bordercolor 0 0 0 .75 }
    }

//	SETTINGS	//


// HOST //
    itemDef {
      	name host
	group grpsettings
      	type ITEM_TYPE_EDITFIELD
	text "Host Name:"
	cvar "sv_hostname"
	maxChars 32
	maxPaintChars 10
      	rect 50 220 128 12 
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 65
      	textaligny 12
	textscale .25        
      	forecolor 1 1 1 1
      	visible 1  
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
    }

    

    itemDef {
      	name host
	group grpsettings
      	type ITEM_TYPE_NUMERICFIELD
	text "Maximum Players:"
	cvar "sv_maxclients"
      	rect 50 235 128 12 
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 65
	maxchars 4
      	textaligny 12
	textscale .25        
      	forecolor 1 1 1 1
      	visible 1  
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
    	}
		
    itemDef {
      	name host
	group grpsettings
 	type ITEM_TYPE_YESNO
	text "Require Password:"
	cvar "g_needpassword"
      	rect 50 250 128 12 
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 65
      	textaligny 12
	textscale .25        
      	forecolor 1 1 1 1
      	visible 1  
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
    	}

    itemDef {
      	name host
	group grpsettings
      	type 4
	text "Password:"
