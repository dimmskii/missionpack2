    itemDef {
  	name host
	group grpsettings
      	type ITEM_TYPE_YESNO
	text "Pure Server:"
	cvar "sv_pure"
      	rect 50 280 128 12 
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 65
      	textaligny 12
	textscale .25        
      	forecolor 1 1 1 1
      	visible 1  
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
    	}

    itemDef {
      	name host
	group grpsettings
      	type ITEM_TYPE_MULTI
	text "Dedicated:"
	// syntax for this is cvar name followed by a semicolan separated list of choices first choice equals 0
	// dedicated is a special cvar in that as soon as it is set, the game goes to console only so the ui catches this one specifically
	cvar "ui_dedicated"
	cvarFloatList { "No" 0 "LAN" 1 "Internet" 2 }
	rect 50 295 128 12 
	textalign ITEM_ALIGN_RIGHT
	textalignx 65
	textaligny 12
	textscale .25        
      	forecolor 1 1 1 1
     	visible 1 
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
    	}

	itemDef {
		name host
		group grpsettings
		type ITEM_TYPE_MULTI
		text "Punkbuster:"
		cvar "sv_punkbuster"
		cvarFloatList { "No" 0 "Yes" 1 }
		rect 50 310 128 12 
		textalign ITEM_ALIGN_RIGHT
		textalignx 65
		textaligny 12
		textscale .25        
		forecolor 1 1 1 1
		visible 1 
	mouseEnter { fadein message_host } 
	mouseExit { fadeout message_host } 
	}
	
