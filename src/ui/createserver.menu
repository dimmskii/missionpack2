// GAME FACTORY INFO DISPLAY //

itemDef {
	name gfactoryinfo
	rect 204 50 227 113	
		ownerdraw UI_GAMEFACTORYINFO
		textalign 0
		textalignx 4
		textaligny 23
		textscale .25
		forecolor .8 .8 .8 1
		visible 1
		decoration
		style 1
}


// CUSTOM GAME RULES //

	itemDef {
		name customrules
		group grpsettings
		type ITEM_TYPE_MULTI
		text "Game Type:"
		cvar "ui_gametype"
		cvarFloatList { "Free For All" 0 "Tournament" 1 "TDM" 3 "Clan Arena" 4 "Capture the Flag" 5 "One Flag CTF" 6 "Overload" 7 "Harvester" 8 "Arena" 14 }
		rect 260 60 128 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 65
		textaligny 12
		textscale .25
		forecolor 1 1 1 1
		visible 1
		cvarTest "ui_hostGameFactory"
		showCvar { "-1" }
		mouseEnter { fadein message_customrules }
		mouseExit { fadeout message_customrules }
	}


