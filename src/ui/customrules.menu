// BACK BAR	//


	itemDef {
		name gotobar
		style 2
		rect 0 430 640 30 
		textscale 0.4
		textalign 0 		// center
		textalignx 60 		// x alignment point for text
							// use it to offset left/right text from the edge 
							// or to center the text on a different point
		textaligny 21        
		style 2
		border 4
		bordercolor 0.5 0.5 0.5 0.75
		bordersize 2
		backcolor 0 0 0 .75
		visible 1 
		mouseEnter { setcolor backcolor .25 .25 .25 .75 }
		mouseExit { setcolor backcolor 0 0 0 .75 }
		decoration 
	}

	itemDef {
		name back
		style 3
		background "ui/assets/backarrow.tga"
		rect 16 424 50 50 
		visible 1 
		action {  play "sound/misc/menu3.wav" ; close customrules ; open createserver }
		mouseEnter { hide back ; show back_alt ; fadein message_back }
	}

	itemDef {
		name back_alt
		style WINDOW_STYLE_SHADER
		background "ui/assets/backarrow_alt.tga"
		rect 14 422 54 54 
		backcolor 0 0 0 0
		forecolor 1 1 1 1
		visible 0
		type ITEM_TYPE_BUTTON
		mouseExit { hide back_alt ; show back ; fadeout message_back }	  
		action { play "sound/misc/menu3.wav" ; close customrules ; open createserver }	  
	}



//	MESSAGES	//

	itemDef {
		name message_rule
		group grpmessage
		style 0 
		rect 320 430 128 30
		textalign 1
		textstyle 1
		textalignx 0
		textaligny 25
		textscale .416
		text "Select to edit game rule"
		forecolor 1 1 1 1
		decoration 
		visible 0
	}

	itemDef {
		name message_back
		group grpmessage
		style 0 
		rect 320 430 128 30
		textalign 1
		textstyle 1
		textalignx 0
		textaligny 25
		textscale .416
		text "Back"
		forecolor 1 1 1 1
		decoration 
		visible 0
	}


	itemDef {
		name fadebox
		style WINDOW_STYLE_FILLED
		background "ui/assets/fadebox.tga"
		forecolor 0 0 0 1
		backcolor 0 0 0 1
		rect 0 0 640 480
		visible 1 
		decoration
	}

}

