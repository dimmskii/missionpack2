#include "ui/menudef.h"

{
\\ ADVANCED RULE EDITING MENU FOR WHEN ui_hostGameFactory="-1" -- RESULTING IN g_factory="" \\

  menuDef {
	name "customrules"
	visible 0
	fullscreen MENU_TRUE
	rect 0 0 640 480
	background "menuback_b"
	outOfBoundsClick	
	focusColor 1 .75 0 1
	disableColor .5 .5 .5 1
	onEsc {
		play "sound/misc/menu3.wav" ; close customrules ; open createserver }
		onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; 
		fadeout fadebox ; 
		uiScript loadArenas_new ;
		hide lightning ; 
		hide accept_alt ; 
		show accept ;
		hide back_alt ;
		show back ;
		hide grpmessage
	}


// Spanning BG

	itemDef {
		name window
		rect 2 50 630 370	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor 1 1 1 .25
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}


// Column BGs

	itemDef {
		name window
		rect 2 50 208 370	
