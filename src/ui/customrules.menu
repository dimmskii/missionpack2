#include "ui/menudef.h"

{
\\ ADVANCED RULE EDITING MENU FOR WHEN ui_hostGameFactory="-1" -- RESULTING IN g_factory="" \\

  menuDef {
	name "customrules"
	visible 0
	fullscreen MENU_TRUE
	rect 0 0 640 480
	background "menuback_b"
	outOfBoundsClick	
	focusColor 1 .75 0 1
	onEsc {
		play "sound/misc/menu3.wav" ; close customrules ; open createserver }
		onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; 
		fadeout fadebox ; 
		uiScript loadArenas_new ;
		hide lightning ; 
		hide accept_alt ; 
		show accept ;
		hide back_alt ;
		show back ;
		hide grpmessage
	}


// Spanning BG

	itemDef {
		name window
		rect 2 50 630 370	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor 1 1 1 .25
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}


// Column BGs

	itemDef {
		name window
		rect 2 50 208 370	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor 1 1 1 .25
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}

	itemDef {
		name window
		rect 212 50 209 370	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor 1 1 1 .25
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}

	itemDef {
		name window
		rect 423 50 208 370	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor 1 1 1 .25
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}

// TOP BAR	//

  itemDef {
		name levelbar
		style 2
		text "CUSTOMIZE GAME RULES"
		rect 0 5 640 40 
		textstyle 6
		textscale 0.416
		textalign 1 		// center
		textalignx 320 		// x alignment point for text
							// use it to offset left/right text from the edge 
							// or to center the text on a different point
		textaligny 27 
		forecolor 1 1 1 1       
		style 2
		border 4
		bordercolor 0.5 0.5 0.5 0.75
		bordersize 2
		backcolor 0.25 0.25 0.25 0.75
		visible 1 
		decoration 
    }



// GENERAL  //

	itemDef {
		name general
		group grpsettings
		type ITEM_TYPE_YESNO
		text "Instagib:"
