// ~Dimmskii -- per-part enemy hex color swatches (replaces the dead SLIDER_COLOR block above)
	itemDef {
      		name display
		group grpOptions
      		type ITEM_TYPE_HEXCOLOR
		text "Enemy Head Color:"
		cvar "cg_enemyHeadColor"
		rect 99 355 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 128
      		textaligny 20
		textscale .3
      		forecolor 1 1 1 1
      		visible 0
		cvarTest "cg_enemyModel"
			enableCvar { "pm" ; "fb" }
		action { play "sound/misc/menu1.wav" ; hexcoloropen } // ~Dimmskii
    		}

	itemDef {
