itemDef {
	name ctr_comms
	text "Comms"
	type 1
	textscale .3
	group grpOptionsbutton
	style WINDOW_STYLE_FILLED
	rect 306 6 100 26
	textalign 1
	textalignx 50
	textaligny 20
