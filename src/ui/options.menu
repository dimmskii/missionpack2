itemDef {
      		name hud				
		group grpOptions
		text "Crosshair:"
		rect 227 175 20 20
		ownerdraw UI_CROSSHAIR
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 0 
      		textaligny 20
		textscale .3        
      		forecolor 1 1 1 1
